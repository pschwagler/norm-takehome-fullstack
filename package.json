{
  "name": "norm-takehome-fullstack",
  "version": "1.0.0",
  "description": "This repository contains a client and server codebase.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload --env-file .env",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "docker compose up --build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "pytest tests/",
    "test:frontend": "npm run test:run --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "format": "npm run format --prefix frontend",
    "format:check": "npm run format:check --prefix frontend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pschwagler/norm-takehome-fullstack.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/pschwagler/norm-takehome-fullstack/issues"
  },
  "homepage": "https://github.com/pschwagler/norm-takehome-fullstack#readme",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1"
  }
}
